{
  "$comment": "Example site configuration. Copy to dungeon.json and edit. The game loads dungeon.json from its own directory and falls back to this file if dungeon.json is missing. Every path is relative to this file.",
  "schema": "dungeon-scroller/config@1",
  "title": "Dungeon Scroller",

  "assets": {
    "spritesheets": [
      "assets/sprites/players/light_space_mage_spritesheet.json",
      "assets/sprites/players/fire_mage_spritesheet.json",
      "assets/sprites/players/water_mage_spritesheet.json",
      "assets/sprites/players/wind_mage_spritesheet.json",
      "assets/sprites/players/earth_mage_spritesheet.json",
      "assets/sprites/players/dark_swordsman_spritesheet.json",
      "assets/sprites/enemies/undead_enemy_spritesheet.json",
      "assets/sprites/enemies/undead_tier2_spritesheet.json",
      "assets/sprites/bosses/undead_boss_spritesheet.json",
      "assets/sprites/objects/interactive_world_objects_spritesheet.json",
      "assets/sprites/objects/interactive_minigame_objects_spritesheet.json",
      "assets/sprites/projectiles/projectiles_spritesheet.json",
      "assets/sprites/NPCs/shopkeeper_spritesheet.json",
      "assets/sprites/NPCs/traveling_merchant_spritesheet.json",
      "assets/sprites/NPCs/village_elder_spritesheet.json",
      "assets/sprites/NPCs/village_priest_spritesheet.json",
      "assets/sprites/NPCs/young_male_villager_spritesheet.json"
    ],
    "atlases": [
      "assets/sprites/games/playing_card_spritesheet.json",
      "assets/sprites/games/hero_playing_card_spritesheet.json",
      "assets/sprites/games/npc_playing_card_spritesheet.json",
      "assets/sprites/games/polyhedral_dice_spritesheet.json"
    ],
    "parallax": [
      "assets/tilesheets/dungeon_parallax.json",
      "assets/tilesheets/graveyard_parallax.json"
    ],
    "backdrops": [
      "assets/sprites/menus/welcome_screen_spritesheet.json",
      "assets/sprites/menus/main_menu_background_spritesheet.json"
    ],
    "turnarounds": "assets/turnaround/turnarounds.json",
    "tilesets": [
      "assets/tilesheets/old_stone_dungeon_tileset.json",
      "assets/tilesheets/ruined_graveyard_tileset.json"
    ],
    "cards": [
      "assets/cards/light_space_mage_card.json",
      "assets/cards/fire_mage_card.json",
      "assets/cards/water_mage_card.json",
      "assets/cards/wind_mage_card.json",
      "assets/cards/earth_mage_card.json",
      "assets/cards/dark_swordsman_card.json",
      "assets/cards/undead_dragon_card.json",
      "assets/cards/undead_fenrir_card.json",
      "assets/cards/death_monarch_card.json",
      "assets/cards/shopkeeper_card.json",
      "assets/cards/traveling_merchant_card.json",
      "assets/cards/village_elder_card.json",
      "assets/cards/village_priest_card.json",
      "assets/cards/young_male_villager_card.json",
      "assets/cards/barrel_card.json",
      "assets/cards/building_blocks_card.json",
      "assets/cards/burial_urn_card.json",
      "assets/cards/checkpoint_flag_card.json",
      "assets/cards/chess_set_card.json",
      "assets/cards/computer_game_card.json",
      "assets/cards/death_knight_card.json",
      "assets/cards/dungeon_dice_card.json",
      "assets/cards/dungeon_relic_card.json",
      "assets/cards/gem_card.json",
      "assets/cards/gold_coin_card.json",
      "assets/cards/gravestone_card.json",
      "assets/cards/healing_potion_card.json",
      "assets/cards/healing_shrine_card.json",
      "assets/cards/iron_key_card.json",
      "assets/cards/lever_card.json",
      "assets/cards/lich_card.json",
      "assets/cards/mahjongg_set_card.json",
      "assets/cards/normal_skeleton_card.json",
      "assets/cards/playing_card_deck_card.json",
      "assets/cards/skeleton_knight_card.json",
      "assets/cards/space_potion_card.json",
      "assets/cards/spell_scroll_card.json",
      "assets/cards/treasure_chest_card.json",
      "assets/cards/undead_wolf_card.json",
      "assets/cards/wall_torch_card.json",
      "assets/cards/wight_card.json",
      "assets/cards/wooden_crate_card.json"
    ]
  },

  "catalogs": {
    "$comment": "Gameplay values: stats, abilities, behaviour, collision and hit boxes.",
    "players": "data/players.json",
    "enemies": "data/enemies.json",
    "bosses": "data/bosses.json",
    "objects": "data/objects.json",
    "npcs": "data/npcs.json",
    "audio": "data/audio.json"
  },

  "levels": "data/levels.json",

  "display": {
    "defaultViewTiles": 8,
    "minViewTiles": 4,
    "maxViewTiles": 24,
    "pixelPerfect": true,
    "parallax": true,
    "parallaxReplacesBackgroundTiles": true,
    "parallaxGround": 0.74,
    "backdrops": { "title": "welcome_screen", "menus": "main_menu_background" }
  },

  "controls": {
    "$comment": "KeyboardEvent.code values; each action accepts several keys. Players can rebind these in the settings screen; their choices are stored in the browser and override these defaults.",
    "left": ["ArrowLeft"],
    "right": ["ArrowRight"],
    "up": ["ArrowUp"],
    "down": ["ArrowDown"],
    "jump": ["Space"],
    "run": ["ShiftLeft", "ShiftRight"],
    "attack1": ["KeyZ"],
    "attack2": ["KeyX"],
    "attack3": ["KeyC"],
    "teleport": ["KeyV"],
    "fly": ["KeyF"],
    "interact": ["KeyE"],
    "zoomIn": ["Equal", "NumpadAdd"],
    "zoomOut": ["Minus", "NumpadSubtract"],
    "pause": ["Escape"],
    "mute": ["KeyM"],
    "debug": ["Backquote"]
  },

  "rules": {
    "lives": 9999,
    "respawn": "checkpoint",
    "touchDamage": true,
    "touchKnockback": 220
  },

  "difficulty": {
    "$comment": "Multipliers applied on top of the catalog values. 1 means unchanged.",
    "enemyHealth": 1,
    "enemyDamage": 1,
    "touchDamage": 1,
    "playerDamage": 1,
    "attackSpeed": 1,
    "mpRegen": 1,
    "loot": 1
  },

  "physics": {
    "tickRate": 60,
    "gravity": 2400,
    "maxFallSpeed": 1400,
    "runSpeedMultiplier": 1.75
  },

  "audio": {
    "master": 1.0,
    "music": 0.6,
    "sfx": 0.8,
    "voice": 1.0,
    "standIn": true
  },

  "speech": {
    "$comment": "bubble: speech bubbles only. webspeech: bubbles, and lines are also read aloud by the browser's voice unless the player turns that off.",
    "provider": "bubble"
  },

  "generator": {
    "defaultTheme": "old_stone_dungeon",
    "defaultLength": 140,
    "defaultDifficulty": 1
  },

  "api": null
}
