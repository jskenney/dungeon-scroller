{
  "$comment": "Example site configuration. Copy to dungeon.json and edit. The game loads dungeon.json from its own directory and falls back to this file if dungeon.json is missing. Every path is relative to this file.",
  "schema": "dungeon-scroller/config@1",
  "title": "Dungeon Scroller",

  "assets": {
    "spritesheets": [
      "assets/sprites/players/light_space_mage_spritesheet.json",
      "assets/sprites/players/fire_mage_spritesheet.json",
      "assets/sprites/players/water_mage_spritesheet.json",
      "assets/sprites/players/wind_mage_spritesheet.json",
      "assets/sprites/players/earth_mage_spritesheet.json",
      "assets/sprites/players/dark_swordsman_spritesheet.json",
      "assets/sprites/enemies/undead_enemy_spritesheet.json",
      "assets/sprites/enemies/undead_tier2_spritesheet.json",
      "assets/sprites/bosses/undead_boss_spritesheet.json",
      "assets/sprites/objects/interactive_world_objects_spritesheet.json"
    ],
    "tilesets": [
      "assets/tilesheets/old_stone_dungeon_tileset.json",
      "assets/tilesheets/ruined_graveyard_tileset.json"
    ],
    "cards": [
      "assets/cards/light_space_mage_card.json",
      "assets/cards/fire_mage_card.json",
      "assets/cards/water_mage_card.json",
      "assets/cards/wind_mage_card.json",
      "assets/cards/earth_mage_card.json",
      "assets/cards/dark_swordsman_card.json",
      "assets/cards/undead_dragon_card.json",
      "assets/cards/undead_fenrir_card.json",
      "assets/cards/death_monarch_card.json"
    ]
  },

  "catalogs": {
    "$comment": "Gameplay values: stats, abilities, behaviour, collision and hit boxes.",
    "players": "data/players.json",
    "enemies": "data/enemies.json",
    "bosses": "data/bosses.json",
    "objects": "data/objects.json"
  },

  "levels": "data/levels.json",

  "display": {
    "defaultViewTiles": 8,
    "minViewTiles": 4,
    "maxViewTiles": 24,
    "pixelPerfect": true
  },

  "controls": {
    "$comment": "KeyboardEvent.code values; each action accepts several keys. Players can rebind these in the settings screen; their choices are stored in the browser and override these defaults.",
    "left": ["ArrowLeft"],
    "right": ["ArrowRight"],
    "up": ["ArrowUp"],
    "down": ["ArrowDown"],
    "jump": ["Space"],
    "run": ["ShiftLeft", "ShiftRight"],
    "attack1": ["KeyZ"],
    "attack2": ["KeyX"],
    "attack3": ["KeyC"],
    "teleport": ["KeyV"],
    "fly": ["KeyF"],
    "interact": ["KeyE"],
    "zoomIn": ["Equal", "NumpadAdd"],
    "zoomOut": ["Minus", "NumpadSubtract"],
    "pause": ["Escape"],
    "mute": ["KeyM"],
    "debug": ["Backquote"]
  },

  "rules": {
    "lives": 9999,
    "respawn": "checkpoint",
    "touchDamage": true,
    "touchKnockback": 220
  },

  "difficulty": {
    "$comment": "Multipliers applied on top of the catalog values. 1 means unchanged.",
    "enemyHealth": 1,
    "enemyDamage": 1,
    "touchDamage": 1,
    "playerDamage": 1,
    "mpRegen": 1,
    "loot": 1
  },

  "physics": {
    "tickRate": 60,
    "gravity": 2400,
    "maxFallSpeed": 1400,
    "runSpeedMultiplier": 1.75
  },

  "audio": {
    "master": 1.0,
    "music": 0.6,
    "sfx": 0.8,
    "voice": 1.0
  },

  "speech": {
    "provider": "bubble"
  },

  "generator": {
    "defaultTheme": "old_stone_dungeon",
    "defaultLength": 140,
    "defaultDifficulty": 1
  },

  "api": null
}
